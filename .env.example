# Copy to .env and edit. NEVER commit .env.

# Flask session/CSRF signing secret. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# local = files stored in ./instance/local_bucket (no cloud needed)
# r2    = private Cloudflare R2 bucket
STORAGE_BACKEND=local

# AES-256 key (base64). Generate: python generate_key.py
# Optional in local mode (a dev key is auto-created), REQUIRED for r2.
# If you lose this key your backups can NOT be decrypted.
LOGVAULT_MASTER_KEY=

# --- Cloudflare R2 (only when STORAGE_BACKEND=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=logvault-archive

# Optional
MAX_UPLOAD_MB=100
# ENABLE_TAMPER_DEMO=1
